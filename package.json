{
  "name": "clipper",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api": "cd apps/api && .venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000",
    "web": "cd apps/web && npm run dev",
    "build:web": "cd apps/web && npm run build",
    "render": "cd apps/render && node render.mjs"
  }
}
